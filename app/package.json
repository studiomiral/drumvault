{
  "name": "drumvault",
  "productName": "Warehouse",
  "version": "0.2.0",
  "private": true,
  "description": "Club house tracks from your own stems: the Drumvault drum library, bass, keys, disco hits and an arrangement.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --mac dir --arm64",
    "dist:linux": "electron-vite build && electron-builder --linux dir"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "immer": "10.1.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.13",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "electron": "42.11.18",
    "electron-builder": "26.17.0",
    "electron-vite": "4.0.1",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.studiomiral.drumvault",
    "productName": "Warehouse",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../engine",
        "to": "engine",
        "filter": [
          "pyproject.toml",
          "uv.lock",
          ".python-version",
          "README.md",
          "drumvault_engine/**/*.py"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "category": "public.app-category.music"
    },
    "linux": {
      "target": "dir",
      "category": "Audio"
    },
    "npmRebuild": false,
    "publish": null,
    "icon": "build/icon.png"
  },
  "author": "Studio Miral"
}
