{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "composite": true,
    "noEmit": true
  },
  "include": ["electron/**/*.ts", "src/lib/**/*.ts", "src/types/**/*.ts", "src/audio/*.ts", "src/api.ts", "src/store/project.ts", "src/store/arrange.ts",
              "src/arrange/geometry.ts", "tests/**/*.ts",
              "electron.vite.config.ts", "vitest.config.ts"]
}
